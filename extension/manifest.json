{
  "manifest_version": 3,
  "name": "TrackDrop",
  "version": "1.0",
  "description": "Send Komoot and RideWithGPS routes to your TrackDrop app on your phone via push notification.",
  "permissions": ["activeTab", "storage", "scripting", "cookies"],
  "host_permissions": [
    "https://sendtrack-fptlqp3r2a-uc.a.run.app/*",
    "https://api.komoot.de/*",
    "https://ridewithgps.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrackDrop"
  }
}