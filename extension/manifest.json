{
  "manifest_version": 3,
  "name": "TrackDrop",
  "version": "1.0",
  "description": "Send Komoot, RideWithGPS and OpenRunner routes to your TrackDrop app on your phone via push notification.",
  "browser_specific_settings": {
    "gecko": {
      "id": "trackdrop@tuntori.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["activeTab", "storage", "scripting", "cookies"],
  "host_permissions": [
    "https://us-central1-trackdrop-ea99a.cloudfunctions.net/*",
    "https://sendtrack-fptlqp3r2a-uc.a.run.app/*",
    "https://www.komoot.com/*",
    "https://api.komoot.de/*",
    "https://ridewithgps.com/*",
    "https://api.openrunner.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrackDrop"
  }
}
