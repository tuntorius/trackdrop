<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F3EC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#4F6814">
                
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_launcher_foreground"
                    android:scaleType="centerCrop"
                    android:contentDescription="TrackDrop Logo" />     
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TrackDrop"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share a link or push from PC. Your route appears instantly."
                    android:textSize="12.5sp"
                    android:textColor="#4F6814" />
            </LinearLayout>
        </LinearLayout>

        <!-- Read-Only URL Label -->
        <TextView
            android:id="@+id/urlLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:hint="Waiting for track..."
            android:textSize="14sp"
            android:background="@drawable/bg_url_field"
            android:padding="16dp"
            android:drawableStart="@android:drawable/ic_menu_directions"
            android:drawablePadding="8dp"
            android:drawableTint="#4F6814"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:autofillHints=""
            android:imeOptions="actionDone" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/loadingBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            android:layout_gravity="center_vertical" />

        <!-- Error -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:background="#FDECEA"
            android:textColor="#B71C1C"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Tour Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tourCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tourName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/tourStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="#4F6814"
                    android:textStyle="bold" />

                <!-- The Route Preview -->
                <com.tuntori.trackdrop.RoutePreviewView
                    android:id="@+id/routePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp" />
                    
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 1st Button: Share with any app -->
        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_share_button"
            android:text="Share with any app"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:drawableStart="@android:drawable/ic_menu_share"
            android:drawableTint="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:drawablePadding="8dp"
            android:visibility="gone" />

        <!-- 2nd Button: Split Button for Favorite App -->
        <LinearLayout
            android:id="@+id/favAppContainer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_om_button"
            android:visibility="gone"
            android:weightSum="10">

            <Button
                android:id="@+id/btnFavApp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8.5"
                android:background="@android:color/transparent"
                android:text="Pick Favorite App"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:drawableStart="@android:drawable/ic_dialog_map"
                android:drawableTint="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:drawablePadding="8dp"
                android:gravity="center" /> <!-- Changed to center -->

            <View
                android:id="@+id/dividerFavApp"
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnFavAppConfig"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:background="@android:color/transparent"
                android:src="@android:drawable/arrow_down_float"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Pairing Button -->
        <Button
            android:id="@+id/btnPairBrowser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/transparent"
            android:text="Pair with PC Browser"
            android:textColor="#4F6814"
            android:textAllCaps="false"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>